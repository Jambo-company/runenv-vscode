{
  "name": "runenv-shared",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./dotenv": {
      "types": "./dotenv.d.ts",
      "default": "./dotenv.js"
    },
    "./file-secret": {
      "types": "./file-secret.d.ts",
      "default": "./file-secret.js"
    },
    "./workspace-preset": {
      "types": "./workspace-preset.d.ts",
      "default": "./workspace-preset.js"
    }
  },
  "files": [
    "dotenv.js",
    "dotenv.d.ts",
    "file-secret.js",
    "file-secret.d.ts",
    "index.js",
    "index.d.ts",
    "workspace-preset.js",
    "workspace-preset.d.ts"
  ]
}
